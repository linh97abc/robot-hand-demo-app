{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robot Hand Rig",
  "version": "0.1.0",
  "identifier": "com.example.robothandrig",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bàn tay robot · 5 ngón",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
